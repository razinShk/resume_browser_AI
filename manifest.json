{
  "manifest_version": 3,
  "name": "Apply Assist Pro — AI Job Application Copilot",
  "version": "1.0.0",
  "description": "Universal 1-click job application copilot inspired by Jobright. Auto-fills forms, attaches resumes, calculates ATS match, tailors skills, and advances pages.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apply Assist Pro",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "defaultProfile.js",
        "pdfGenerator.js",
        "atsEngine.js",
        "matcher.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
